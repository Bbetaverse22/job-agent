# Copy to .env and fill in. Everything here is optional except an LLM provider,
# and even that is only needed for `run`; `discover` works with this file empty.
#
# Keep comments on their own lines. python-dotenv reads `KEY=   # note` as the
# value "# note" when the key is blank. (The code now ignores such values, but a
# blank line is still the clear way to leave a setting unset.)

# ---- LLM provider (required for `run`, unused by `discover`) ----
# openai | anthropic | bedrock
LLM_PROVIDER=openai
# Blank uses the provider default:
#   openai     gpt-5.6-luna  (cheapest; gpt-5.6-terra drafts better)
#   anthropic  claude-sonnet-4-6
#   bedrock    us.anthropic.claude-sonnet-4-6-v1:0
MODEL_ID=
# Only the key for your chosen provider is needed.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AWS_REGION=us-east-1

# ---- Your constraints ----
# 0 disables. A stated salary ceiling below this rejects the role; an unstated
# salary is flagged "unconfirmed salary", never hidden.
SALARY_FLOOR_USD=0
# One commutable city, e.g. austin. A hybrid or onsite posting there still
# passes the filter. Blank means fully remote only.
HOME_METRO=
# Comma-separated landmarks that must survive resume tailoring, e.g.
# Acme Corp,Globex,MSc. Blank skips that half of the lossiness check.
RESUME_MUST_KEEP=
# Comma-separated whole-word title terms to drop, e.g. staff,principal,manager.
# "Member of Technical Staff" is a job title, not a level, and is never matched
# by "staff".
EXCLUDE_TITLE_TERMS=

# ---- Telegram approval gate (optional; CLI approval works without it) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- job-radar adapter (optional). Set ONE; the first match wins ----
# Path to a `job-radar list --json` export:
JOBRADAR_JSON=
# Path to job-radar's data/job-radar.db (opened read-only):
JOBRADAR_DB=
# A command that prints JSON, e.g. job-radar list --new --json
JOBRADAR_CMD=

# ---- Aggregator cascade (optional; Remotive is keyless and always runs) ----
# rapidapi.com, JSearch free plan
JSEARCH_API_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Max postings kept from the aggregator cascade
CASCADE_LIMIT=25

# ---- Cost guards ----
# Scoring calls per run. The overflow is deferred, not dropped, and re-queued on
# the next run. Set it low (e.g. 5) while testing.
MAX_LLM_SCORES_PER_RUN=25
# The query-broadening loop, off by default
ENABLE_REFORMULATION=false
MAX_REFORMULATIONS=1
MIN_GOOD_MATCHES=3

# ---- Observability (optional). LangSmith traces every node with these set ----
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=job-agent

# ---- Optional Supabase mirror of the local tracker ----
SUPABASE_URL=
SUPABASE_KEY=
