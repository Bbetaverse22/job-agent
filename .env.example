# Copy to .env and fill in. Everything here is optional except an LLM provider,
# and even that is only needed for `run`; `discover` works with this file empty.

# ---- LLM provider (required for `run`, unused by `discover`) ----
LLM_PROVIDER=bedrock            # bedrock | anthropic
MODEL_ID=                       # blank uses the provider default
ANTHROPIC_API_KEY=              # only when LLM_PROVIDER=anthropic
AWS_REGION=us-east-1            # only when LLM_PROVIDER=bedrock

# ---- Your constraints ----
SALARY_FLOOR_USD=0              # 0 disables. A stated ceiling below this rejects;
                                # an unstated salary is flagged, never hidden
HOME_METRO=                     # one commutable city, e.g. "austin". A hybrid or
                                # onsite posting there still passes the filter.
                                # Blank means fully remote only
RESUME_MUST_KEEP=               # comma-separated landmarks that must survive resume
                                # tailoring, e.g. "Acme Corp,Test Engineer,Ph.D."
                                # Blank skips that half of the lossiness check

# ---- Telegram approval gate (optional; CLI approval works without it) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- job-radar adapter (optional). Set ONE; first match wins ----
JOBRADAR_JSON=                  # path to a `job-radar list --json` export
JOBRADAR_DB=                    # path to job-radar's data/job-radar.db (read-only)
JOBRADAR_CMD=                   # e.g. job-radar list --new --json

# ---- Aggregator cascade (all optional; Remotive is keyless and always runs) ----
JSEARCH_API_KEY=                # rapidapi.com, JSearch free plan
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
CASCADE_LIMIT=25                # max postings kept from the aggregator cascade

# ---- Cost guards ----
MAX_LLM_SCORES_PER_RUN=25       # scoring calls per run; the overflow is deferred,
                                # not dropped, and re-queued on the next run
ENABLE_REFORMULATION=false      # the query-broadening loop, off by default
MAX_REFORMULATIONS=1
MIN_GOOD_MATCHES=3

# ---- Observability (optional). LangSmith traces every node with these set ----
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=job-agent

# ---- Optional Supabase mirror of the local tracker ----
SUPABASE_URL=
SUPABASE_KEY=
